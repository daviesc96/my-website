---
import Layout from './Layout.astro';
import Lightbox from '../components/Lightbox.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  cover?: ImageMetadata;
  coverAlt?: string;
  introImages?: string[];
  gallery?: string[];
  youtubeEmbed?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  cover,
  coverAlt = '',
  introImages = [],
  gallery = [],
  youtubeEmbed,
} = Astro.props;

const fmt = (d: Date) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const iso = (d: Date) => new Date(d).toISOString().slice(0, 10);

// Dynamically import images from src/assets/devices/
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/devices/**/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
  { eager: true }
);

// Helper to find and import an image by its relative path (e.g., "device_1/analog-01.jpg")
const loadDeviceImage = (relativePath: string): ImageMetadata => {
  // Find the module key by matching the end of the path
  const moduleKey = Object.keys(allImages).find((key) => {
    // Normalize both paths for comparison
    const normalizedKey = key.replace(/\.\.\//g, '').replace(/^.*assets\//, '');
    return normalizedKey.endsWith(relativePath);
  });
  
  if (!moduleKey) {
    // Log available keys for debugging
    console.warn(`Image not found: ${relativePath}`);
    console.warn('Available images:', Object.keys(allImages).slice(0, 5));
    throw new Error(`Device image "${relativePath}" not found. Expected format: device_X/filename.jpg`);
  }
  
  const imageModule = allImages[moduleKey as keyof typeof allImages];
  return imageModule.default;
};

// Resolve all intro images
const resolvedIntroImages = introImages.map((imagePath) => ({
  path: imagePath,
  meta: loadDeviceImage(imagePath),
}));

// Resolve all gallery images
const resolvedGalleryImages = gallery.map((imagePath) => ({
  path: imagePath,
  meta: loadDeviceImage(imagePath),
}));
---

<Layout title={title} description={description}>
  <article class="post page device-post">
    {/* <p class="post__eyebrow"><a href="/devices/device_1">Back to Devices</a></p> */}
    <h1 class="post__title">{title}</h1>

    <div class="post__meta">
      <time datetime={iso(pubDate)}>{fmt(pubDate)}</time>
    </div>

    {/* Hero/lead image */}
    {
      cover && (
        <figure class="post__cover">
          <Image
            src={cover}
            alt={coverAlt}
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 1024px) 760px, 100vw"
          />
        </figure>
      )
    }

    {/* Main text body */}
    <div class="prose post__body">
      <slot />
    </div>

    {/* Intro images (2-up grid like Gallery component) */}
    {
      resolvedIntroImages.length > 0 && (
        <section class="photo-grid post-grid" aria-label="Intro photos">
          {resolvedIntroImages.map((item) => (
            <button
              class="photo-tile"
              type="button"
              aria-label={`${item.path} — view larger`}
              data-lightbox={`device-intro-${item.path}`}
            >
              <Image
                src={item.meta}
                alt={item.path}
                widths={[380, 760]}
                sizes="(min-width: 1024px) 380px, 100vw"
              />
            </button>
          ))}
        </section>
      )
    }

    {/* YouTube embed (if provided) */}
    {
      youtubeEmbed && (
        <figure class="youtube-embed">
          <iframe
            width="100%"
            height="500"
            src={youtubeEmbed}
            title="Device demo video"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </figure>
      )
    }

    {/* Gallery at bottom */}
    {
      resolvedGalleryImages.length > 0 && (
        <section class="photo-grid post-grid gallery-section" aria-label="Device gallery">
          {resolvedGalleryImages.map((item) => (
            <button
              class="photo-tile"
              type="button"
              aria-label={`${item.path} — view larger`}
              data-lightbox={`device-gallery-${item.path}`}
            >
              <Image
                src={item.meta}
                alt={item.path}
                widths={[380, 760]}
                sizes="(min-width: 1024px) 380px, 100vw"
              />
            </button>
          ))}
        </section>
      )
    }

    {updatedDate && <p class="post__updated">Updated {fmt(updatedDate)}</p>}
  </article>

  {/* Full-screen lightbox viewer */}
  <Lightbox />
</Layout>

<style>
  .device-post {
    /* Additional styling for device posts if needed */
  }

  .youtube-embed {
    margin: 2rem 0;
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .gallery-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border, #ddd);
  }
</style>
